    "Samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플"
          }
        }
      }
    },
    "Samples you’ve downloaded with Splice show up on their own. There’s nothing to set up.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Splice로 받은 샘플이 저절로 나타나요. 따로 설정할 것이 없어요."
          }
        }
      }
    },
    "Search names, packs, genres": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름, 팩, 장르 검색"
