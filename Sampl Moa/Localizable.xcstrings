{
  "sourceLanguage": "en",
  "strings": {
    "%.2f sec": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%.2f초"
          }
        }
      }
    },
    "%@ couldn’t be loaded here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 플러그인을 불러올 수 없습니다."
          }
        }
      }
    },
    "%lld bars": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld마디"
          }
        }
      }
    },
    "%lld samples": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sample"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld samples"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 %lld개"
          }
        }
      }
    },
    "%lld slices": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld조각"
          }
        }
      }
    },
    "808 & Bass": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "808·베이스"
          }
        }
      }
    },
    "A MIDI file to play with your own sounds.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 소리로 연주할 MIDI 파일"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가"
          }
        }
      }
    },
    "Add Effects": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이펙트 넣기"
          }
        }
      }
    },
    "Add Plug-in": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인 추가"
          }
        }
      }
    },
    "Add Samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 추가"
          }
        }
      }
    },
    "Add Samples…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 추가…"
          }
        }
      }
    },
    "Add Your Own Folders": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 폴더도 추가할 수 있어요"
          }
        }
      }
    },
    "Add Your Own Samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 샘플을 추가해 보세요"
          }
        }
      }
    },
    "Add a folder of samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플이 들어 있는 폴더를 추가합니다"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체"
          }
        }
      }
    },
    "All Genres": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 장르"
          }
        }
      }
    },
    "All Samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 샘플"
          }
        }
      }
    },
    "All your samples in one place, ready to hear and use.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흩어진 샘플을 한곳에 모아 바로 듣고 바로 쓸 수 있어요."
          }
        }
      }
    },
    "Allow Access": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 허용하기"
          }
        }
      }
    },
    "Allow Access First": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 권한 허용하기"
          }
        }
      }
    },
    "Asked": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청함"
          }
        }
      }
    },
    "At Hits": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 감지"
          }
        }
      }
    },
    "Audio FX": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio FX"
          }
        }
      }
    },
    "Audio Units": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Unit 플러그인"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전"
          }
        }
      }
    },
    "Band-Pass Filter": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밴드패스 필터"
          }
        }
      }
    },
    "Bars": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마디"
          }
        }
      }
    },
    "Built-in Effects": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 이펙트"
          }
        }
      }
    },
    "Bypass": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄기"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Cancel (esc)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소 (esc)"
          }
        }
      }
    },
    "Carry On in Your DAW": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DAW에서 이어서 작업하기"
          }
        }
      }
    },
    "Changes the length without changing the pitch.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음정은 그대로 두고 길이만 바꿉니다."
          }
        }
      }
    },
    "Changes the pitch and the length together, like speeding up a record.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레코드 속도를 바꾸듯 음정과 길이를 함께 바꿉니다."
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 확인…"
          }
        }
      }
    },
    "Choke Group": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초크 그룹"
          }
        }
      }
    },
    "Choose a folder and every audio file in it, including subfolders, will appear here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하면 하위 폴더까지 모든 오디오 파일이 여기에 나타나요."
          }
        }
      }
    },
    "Choose a folder. All the audio files in it and its subfolders will be added.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하세요. 하위 폴더까지 모든 오디오 파일이 추가됩니다."
          }
        }
      }
    },
    "Choose the Part That Plays": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생할 부분 고르기"
          }
        }
      }
    },
    "Chop": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찹"
          }
        }
      }
    },
    "Chop a Loop or a Song": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루프나 곡 찹하기"
          }
        }
      }
    },
    "Clap": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클랩"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패턴 지우기"
          }
        }
      }
    },
    "Clear Filters": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터 지우기"
          }
        }
      }
    },
    "Clear Pattern": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패턴 지우기"
          }
        }
      }
    },
    "Click Add Samples and choose a folder. All its audio files, including subfolders, appear under My Folders.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 추가를 누르고 폴더를 고르면 하위 폴더까지 모든 오디오 파일이 내 폴더에 나타나요."
          }
        }
      }
    },
    "Click Track": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메트로놈"
          }
        }
      }
    },
    "Click a slice to hear it. Drag a line to move it. Double-click to add or remove a line.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조각을 클릭하면 들을 수 있습니다. 선을 끌어 옮기고, 더블 클릭으로 선을 추가하거나 지웁니다."
          }
        }
      }
    },
    "Click to turn this strip with your device’s knobs.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 기기의 노브로 이 스트립을 조절합니다."
          }
        }
      }
    },
    "Click track (K). It’s never part of what gets recorded or exported.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메트로놈 (K). 녹음이나 내보내기에는 들어가지 않습니다."
          }
        }
      }
    },
    "Close Player": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 바 닫기"
          }
        }
      }
    },
    "Compressor": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴프레서"
          }
        }
      }
    },
    "Connect any MIDI controller and it’s ready to play. On an MPK mini, bank A is the bottom two rows of pads here, and bank B is the top two. For other devices, use the gear button to teach it your pads and knobs. Each device’s setup is remembered.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MIDI 컨트롤러를 연결하면 바로 연주할 수 있습니다. MPK mini는 뱅크 A가 화면의 아래 두 줄, 뱅크 B가 위 두 줄입니다. 다른 기기는 톱니바퀴 버튼에서 패드와 노브를 매핑하세요. 기기별 매핑은 기억됩니다."
          }
        }
      }
    },
    "Connect any MIDI controller and it’s ready to play. On an MPK mini, bank A is the bottom two rows of pads here, and bank B is the top two. If the wrong pads play, choose Set Up Device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MIDI 컨트롤러를 연결하면 바로 연주할 수 있습니다. MPK mini는 뱅크 A가 화면의 아래 두 줄, 뱅크 B가 위 두 줄입니다. 다른 패드가 울리면 기기 설정을 선택하세요."
          }
        }
      }
    },
    "Couldn’t export that.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내지 못했습니다."
          }
        }
      }
    },
    "Couldn’t open your Mac’s audio output.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 오디오 출력을 열 수 없습니다."
          }
        }
      }
    },
    "Cut": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찹 방식"
          }
        }
      }
    },
    "Cut Group": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끊기 그룹"
          }
        }
      }
    },
    "Cuts the chosen part into slices and puts one on each pad.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 부분을 잘라 패드마다 하나씩 넣습니다."
          }
        }
      }
    },
    "Cymbal": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심벌"
          }
        }
      }
    },
    "Date Added": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 날짜"
          }
        }
      }
    },
    "Delay": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딜레이"
          }
        }
      }
    },
    "Device Knobs": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 노브"
          }
        }
      }
    },
    "Distortion": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스토션"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "Down the side of the window, like the inspector in Logic Pro, are the selected sound’s channel strip and the Master’s. The Master shapes everything together without touching each pad’s balance. Click Device Knobs on a strip to turn it with your device’s knobs. Double-click any control to put it back.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 옆에는 Logic Pro의 인스펙터처럼 선택한 사운드의 채널 스트립과 마스터 스트립이 있습니다. 마스터는 패드마다 맞춘 밸런스는 그대로 두고 전체 소리를 다듬습니다. 스트립 위쪽의 기기 노브를 누르면 기기의 노브로 그 스트립을 조절합니다. 어떤 컨트롤이든 더블 클릭하면 원래대로 돌아갑니다."
          }
        }
      }
    },
    "Download and install updates automatically": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 자동으로 내려받아 설치"
          }
        }
      }
    },
    "Download from iCloud": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 내려받기"
          }
        }
      }
    },
    "Download samples in the Splice app and they’ll show up here automatically.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Splice 앱에서 샘플을 다운로드하면 여기에 자동으로 나타나요."
          }
        }
      }
    },
    "Downloading from iCloud…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 내려받는 중…"
          }
        }
      }
    },
    "Drag a sample from the list onto a pad. You can also select samples and click an empty pad.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록의 샘플을 패드로 끌어다 놓으세요. 샘플을 선택한 뒤 빈 패드를 클릭해도 됩니다."
          }
        }
      }
    },
    "Drag into Your Project": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중인 앱으로 끌어다 놓아요"
          }
        }
      }
    },
    "Drag into your DAW:": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DAW로 끌어다 놓으세요:"
          }
        }
      }
    },
    "Drag into your project": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 프로젝트에 넣기"
          }
        }
      }
    },
    "Drag samples from the list onto a pad. Drag several at once and they fill the next pads too. You can also select samples and click an empty pad.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록의 샘플을 패드로 끌어다 놓으세요. 여러 개를 끌면 다음 패드까지 차례로 채워집니다. 샘플을 선택한 뒤 빈 패드를 클릭해도 됩니다."
          }
        }
      }
    },
    "Drop a sample here to play it on the keys": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플을 여기에 놓으면 건반으로 연주할 수 있습니다"
          }
        }
      }
    },
    "Drop a sample on Keyboard and every key plays it in tune. Keep Length holds the notes of a chord together. Repitch changes speed with pitch, like speeding up a record.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플을 건반 칸에 놓으면 건반마다 음에 맞게 연주됩니다. 길이 고정은 코드의 음 길이를 맞춰 주고, 리피치는 레코드처럼 피치와 속도가 함께 바뀝니다."
          }
        }
      }
    },
    "Drop a sample straight into Logic Pro, Final Cut Pro, Premiere Pro, or After Effects.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플을 Logic Pro, Final Cut Pro, Premiere Pro, After Effects로 바로 끌어다 놓을 수 있어요."
          }
        }
      }
    },
    "Drum Loop": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드럼 루프"
          }
        }
      }
    },
    "EQ": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EQ"
          }
        }
      }
    },
    "Each Pad Separately": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패드별 파일"
          }
        }
      }
    },
    "Eight knobs shape the selected sound: volume, pitch, speed, delay, low, mid, high, and reverb. The knobs on your device turn the ones in the same place. Double-click a knob to put it back.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노브 8개로 선택한 소리를 다듬습니다. 음량, 음정, 속도, 딜레이, 저음, 중음, 고음, 리버브입니다. 기기의 노브는 같은 자리의 노브를 움직입니다. 노브를 더블 클릭하면 원래대로 돌아갑니다."
          }
        }
      }
    },
