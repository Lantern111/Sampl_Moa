          }
        }
      }
    },
    "Samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플"
          }
        }
      }
    },
    "Samples you’ve downloaded with Splice show up on their own. There’s nothing to set up.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Splice로 받은 샘플이 저절로 나타나요. 따로 설정할 것이 없어요."
          }
        }
      }
    },
    "Scroll to zoom, or drag the bar below.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤로 확대하고, 아래 막대를 끌어 이동합니다."
          }
        }
      }
    },
    "Search names, packs, genres": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름, 팩, 장르 검색"
          }
        }
      }
    },
    "See What’s Playing": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 위치 보기"
          }
        }
      }
    },
    "Send to DAW": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DAW로 내보내기"
          }
        }
      }
    },
    "Send to Keyboard": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건반으로 보내기"
          }
        }
