{
  "sourceLanguage": "en",
  "strings": {
    "%lld samples": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sample"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld samples"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 %lld개"
          }
        }
      }
    },
    "808 & Bass": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "808·베이스"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가"
          }
        }
      }
    },
    "Add Samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 추가"
          }
        }
      }
    },
    "Add Samples…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 추가…"
          }
        }
      }
    },
    "Add Your Own Folders": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 폴더도 추가할 수 있어요"
          }
        }
      }
    },
    "Add Your Own Samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 샘플을 추가해 보세요"
          }
        }
      }
    },
    "Add a folder of samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플이 들어 있는 폴더를 추가합니다"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체"
          }
        }
      }
    },
    "All Genres": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 장르"
          }
        }
      }
    },
    "All Samples": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 샘플"
          }
        }
      }
    },
    "All your samples in one place, ready to hear and use.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흩어진 샘플을 한곳에 모아 바로 듣고 바로 쓸 수 있어요."
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 확인…"
          }
        }
      }
    },
    "Choose a folder and every audio file in it, including subfolders, will appear here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하면 하위 폴더까지 모든 오디오 파일이 여기에 나타나요."
          }
        }
      }
    },
    "Choose a folder. All the audio files in it and its subfolders will be added.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하세요. 하위 폴더까지 모든 오디오 파일이 추가됩니다."
          }
        }
      }
    },
    "Clap": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클랩"
          }
        }
      }
    },
    "Clear Filters": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터 지우기"
          }
        }
      }
    },
    "Click Add Samples and choose a folder. All its audio files, including subfolders, appear under My Folders.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 추가를 누르고 폴더를 고르면 하위 폴더까지 모든 오디오 파일이 내 폴더에 나타나요."
          }
        }
      }
    },
    "Close Player": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 바 닫기"
          }
        }
      }
    },
    "Cymbal": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심벌"
          }
        }
      }
    },
    "Date Added": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 날짜"
          }
        }
      }
    },
    "Download and install updates automatically": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 자동으로 내려받아 설치"
          }
        }
      }
    },
    "Download from iCloud": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 내려받기"
          }
        }
      }
    },
    "Download samples in the Splice app and they’ll show up here automatically.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Splice 앱에서 샘플을 다운로드하면 여기에 자동으로 나타나요."
          }
        }
      }
    },
    "Downloading from iCloud…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 내려받는 중…"
          }
        }
      }
    },
    "Drag into Your Project": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중인 앱으로 끌어다 놓아요"
          }
        }
      }
    },
    "Drag into your project": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 프로젝트에 넣기"
          }
        }
      }
    },
    "Drop a sample straight into Logic Pro, Final Cut Pro, Premiere Pro, or After Effects.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플을 Logic Pro, Final Cut Pro, Premiere Pro, After Effects로 바로 끌어다 놓을 수 있어요."
          }
        }
      }
    },
    "Drum Loop": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드럼 루프"
