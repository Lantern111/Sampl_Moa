      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨"
          }
        }
      }
    },
    "Waiting for your Mac’s audio output…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 오디오 출력을 기다리는 중…"
