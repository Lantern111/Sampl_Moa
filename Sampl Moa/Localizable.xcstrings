    "Play or Pause (Space)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생/일시정지 (스페이스바)"
          }
        }
      }
    },
    "Playback": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생"
          }
        }
      }
    },
    "Press Space to play. ↓ or → moves to the next sample, and ← plays it again from the start.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스바로 재생해요. ↓ 또는 →를 누르면 다음 샘플로 넘어가고, ←를 누르면 처음부터 다시 들려줘요."
          }
        }
      }
    },
    "Press Space to preview · Drag into your project": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스바로 미리듣기 · 끌어서 프로젝트에 넣기"
          }
        }
      }
    },
    "Remove from List": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 제거"
          }
        }
      }
    },
    "Report a Bug…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버그 신고…"
          }
        }
      }
    },
    "Rescan Library": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리 다시 검색"
          }
        }
      }
    },
    "Restart Now": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 다시 시작"
          }
        }
      }
    },
    "Restart Sampl Moa to use the new language.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampl Moa를 다시 시작하면 새 언어로 바뀌어요."
          }
        }
      }
    },
    "Same as System": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템과 동일"
          }
        }
