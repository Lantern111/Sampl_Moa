      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뱅크 %@"
          }
        }
      }
    },
    "Bank %@. B goes to the next bank.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뱅크 %@. B 키로 다음 뱅크로 넘어갑니다."
          }
        }
      }
    },
    "Bars": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마디"
          }
        }
      }
    },
    "Built-in Effects": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 이펙트"
          }
        }
      }
    },
    "Bypass": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄기"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Cancel (esc)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소 (esc)"
          }
        }
      }
    },
    "Carry On in Your DAW": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DAW에서 이어서 작업하기"
          }
        }
      }
    },
    "Changes the length without changing the pitch.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음정은 그대로 두고 길이만 바꿉니다."
          }
        }
      }
    },
    "Changes the pitch and the length together, like speeding up a record.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레코드 속도를 바꾸듯 음정과 길이를 함께 바꿉니다."
          }
        }
      }
    },
    "Changes the speed, not the pitch, so this plays at the sampler’s %lld BPM, and keeps up when the tempo changes. Turning Speed yourself stops it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음정은 그대로 두고 속도를 바꿔 샘플러의 %lld BPM에 맞춰 재생하고, 템포가 바뀌면 따라갑니다. 속도 노브를 직접 돌리면 멈춥니다."
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 확인…"
          }
        }
      }
    },
    "Choke Group": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초크 그룹"
          }
        }
      }
    },
    "Choose a folder and every audio file in it, including subfolders, will appear here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하면 하위 폴더까지 모든 오디오 파일이 여기에 나타나요."
          }
        }
      }
    },
    "Choose a folder. All the audio files in it and its subfolders will be added.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하세요. 하위 폴더까지 모든 오디오 파일이 추가됩니다."
          }
        }
      }
    },
    "Choose the Part That Plays": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생할 부분 고르기"
          }
        }
      }
    },
    "Chop": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찹"
          }
        }
      }
    },
    "Chop a Loop or a Song": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루프나 곡 찹하기"
          }
        }
      }
    },
    "Clap": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클랩"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패턴 지우기"
          }
        }
      }
    },
    "Clear All Pads": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 패드 비우기"
          }
        }
      }
    },
    "Clear Bank %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뱅크 %@ 비우기"
          }
        }
      }
    },
    "Clear Filters": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터 지우기"
          }
        }
      }
    },
    "Clear Pads": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패드 비우기"
          }
        }
      }
    },
    "Clear Pattern": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패턴 지우기"
          }
        }
      }
    },
    "Clear every pad in all four banks?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 뱅크의 모든 패드를 비울까요?"
          }
        }
      }
    },
    "Clear every pad in bank %@?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뱅크 %@의 모든 패드를 비울까요?"
          }
        }
      }
    },
    "Clear pads": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패드 비우기"
          }
        }
      }
    },
    "Click Add Samples and choose a folder. All its audio files, including subfolders, appear under My Folders.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 추가를 누르고 폴더를 고르면 하위 폴더까지 모든 오디오 파일이 내 폴더에 나타나요."
          }
        }
      }
    },
    "Click Track": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메트로놈"
          }
        }
      }
    },
    "Click a slice to hear it. Drag a line to move it. Double-click to add or remove a line.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조각을 클릭하면 들을 수 있습니다. 선을 끌어 옮기고, 더블 클릭으로 선을 추가하거나 지웁니다."
          }
        }
      }
    },
    "Click to turn this strip with your device’s knobs.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 기기의 노브로 이 스트립을 조절합니다."
          }
        }
      }
    },
    "Click track (K). It’s never part of what gets recorded or exported.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메트로놈 (K). 녹음이나 내보내기에는 들어가지 않습니다."
          }
        }
      }
    },
    "Close Player": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 바 닫기"
          }
        }
      }
    },
    "Compressor": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴프레서"
          }
        }
      }
    },
    "Connect any MIDI controller and it’s ready to play. On an MPK mini, bank A is the bottom two rows of pads here, and bank B is the top two. For other devices, use the gear button to teach it your pads and knobs. Each device’s setup is remembered.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MIDI 컨트롤러를 연결하면 바로 연주할 수 있습니다. MPK mini는 뱅크 A가 화면의 아래 두 줄, 뱅크 B가 위 두 줄입니다. 다른 기기는 톱니바퀴 버튼에서 패드와 노브를 매핑하세요. 기기별 매핑은 기억됩니다."
          }
        }
      }
    },
    "Connect any MIDI controller and it’s ready to play. On an MPK mini, bank A is the bottom two rows of pads here, and bank B is the top two. If the wrong pads play, choose Set Up Device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MIDI 컨트롤러를 연결하면 바로 연주할 수 있습니다. MPK mini는 뱅크 A가 화면의 아래 두 줄, 뱅크 B가 위 두 줄입니다. 다른 패드가 울리면 기기 설정을 선택하세요."
          }
        }
      }
    },
    "Connect any MIDI controller and it’s ready to play. On an MPK mini, its own pad bank A plays the bottom two rows here and its bank B the top two. The A to D buttons above the pads switch between four banks of 16, for 64 sounds, and the device plays whichever is showing. For other devices, use the gear button to teach it your pads and knobs. Each device’s setup is remembered.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 MIDI 컨트롤러든 연결하면 바로 연주할 수 있습니다. MPK mini는 기기의 패드 뱅크 A가 여기 아래 두 줄, 뱅크 B가 위 두 줄을 연주합니다. 패드 위의 A~D 버튼으로 16패드짜리 뱅크 네 개를 오가며 64개의 소리를 쓸 수 있고, 기기는 화면에 보이는 뱅크를 연주합니다. 다른 기기는 톱니바퀴 버튼에서 패드와 노브를 매핑하세요. 기기마다 설정이 기억됩니다."
          }
        }
      }
    },
    "Couldn’t export that.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내지 못했습니다."
          }
        }
      }
    },
    "Couldn’t open your Mac’s audio output.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 오디오 출력을 열 수 없습니다."
          }
        }
      }
    },
    "Crush": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크러시"
          }
        }
      }
    },
    "Cut": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찹 방식"
          }
        }
      }
    },
    "Cut Group": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끊기 그룹"
          }
        }
      }
    },
    "Cutoff": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컷오프"
          }
        }
      }
    },
    "Cuts the chosen part into slices and puts one on each pad.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 부분을 잘라 패드마다 하나씩 넣습니다."
          }
        }
      }
    },
    "Cymbal": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심벌"
          }
        }
      }
    },
    "Damping": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "댐핑"
          }
        }
      }
    },
    "Date Added": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 날짜"
          }
        }
      }
    },
    "Decay": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디케이"
          }
        }
      }
    },
    "Delay": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딜레이"
          }
        }
      }
    },
    "Device Knobs": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 노브"
          }
        }
      }
    },
    "Distortion": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스토션"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "Down the side of the window, like the inspector in Logic Pro, are the selected sound’s channel strip and the Master’s. The Master shapes everything together without touching each pad’s balance. Turn Filter left to cut the highs or right to cut the lows, like on a DJ mixer. Click Device Knobs on a strip to turn it with your device’s knobs.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 옆에는 Logic Pro의 인스펙터처럼 선택한 사운드의 채널 스트립과 마스터 스트립이 있습니다. 마스터는 패드마다 맞춘 밸런스는 그대로 두고 전체 소리를 다듬습니다. 필터는 DJ 믹서처럼 왼쪽으로 돌리면 고음이, 오른쪽으로 돌리면 저음이 깎입니다. 스트립 위쪽의 기기 노브를 누르면 기기의 노브로 그 스트립을 조절합니다."
          }
        }
      }
    },
    "Download and install updates automatically": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 자동으로 내려받아 설치"
          }
        }
      }
    },
    "Download from iCloud": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 내려받기"
          }
        }
      }
    },
    "Download samples in the Splice app and they’ll show up here automatically.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Splice 앱에서 샘플을 다운로드하면 여기에 자동으로 나타나요."
          }
        }
      }
    },
    "Downloading from iCloud…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 내려받는 중…"
          }
        }
      }
    },
    "Drag a sample from the list onto a pad. You can also select samples and click an empty pad.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록의 샘플을 패드로 끌어다 놓으세요. 샘플을 선택한 뒤 빈 패드를 클릭해도 됩니다."
          }
        }
      }
    },
    "Drag into Your Project": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중인 앱으로 끌어다 놓아요"
          }
        }
      }
    },
    "Drag into your DAW:": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DAW로 끌어다 놓으세요:"
          }
        }
