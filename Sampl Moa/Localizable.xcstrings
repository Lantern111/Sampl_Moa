            "value": "파형"
          }
        }
      }
    },
    "Welcome to Sampl Moa": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampl Moa에 오신 것을 환영해요"
          }
        }
      }
    },
    "Whole Beat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비트 전체"
          }
        }
      }
    },
    "Your device’s knobs turn this strip.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 노브가 이 스트립을 조절합니다."
