          }
        }
      }
    },
    "Waveform": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형"
          }
        }
      }
    },
    "Welcome to Sampl Moa": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampl Moa에 오신 것을 환영해요"
          }
        }
      }
    },
    "Whole Beat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비트 전체"
          }
        }
      }
    },
    "Width": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭"
          }
        }
      }
    },
    "Your device’s knobs turn this strip.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 노브가 이 스트립을 조절합니다."
          }
        }
      }
    },
    "Your device’s pads and knobs are mapped as they were at first.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 패드와 노브 매핑을 처음 상태로 되돌렸습니다."
          }
        }
      }
    },
    "Zoom to Selection": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 영역 확대"
          }
        }
      }
    },
    "filter.off": {
      "comment": "A filter knob in the middle, doing nothing.",
      "localizations": {
